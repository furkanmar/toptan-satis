POSTGRES_DB=wholesaledb
POSTGRES_USER=wholesale
POSTGRES_PASSWORD=changeme_strong_password

# JWT_SECRET: en az 32 karakter, base64-safe random
# Üret: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_ISSUER=marifoglu.trade
JWT_AUDIENCE=marifoglu.trade

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# Dashboard → R2 → Manage R2 API Tokens → API token üret (Object Read & Write)
R2_ACCOUNT_ID=<your-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=marifoglu-media

# ─── Backup ───────────────────────────────────────────────────────────────────
R2_BACKUP_BUCKET=marifoglu-backups
BACKUP_RETENTION_DAYS=7

# ─── Telegram bildirimleri (backup hata durumunda) ────────────────────────────
# Bot token: @BotFather'dan al
# Chat ID: @userinfobot ile öğren veya bot'a /start gönder → API'den al
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_CHAT_ID=<chat-id>
